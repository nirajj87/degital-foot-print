# Copy to .env and fill only what you use. Never commit .env.

# Strongly recommended — public GitHub search and profile details
GITHUB_TOKEN=

# Optional — official Have I Been Pwned (otherwise XposedOrNot is used)
HIBP_API_KEY=

# Optional — IntelX dark-web mentions
DARKWEB_KEY=
DARKWEB_URL=https://free.intelx.io/

# Required if you bind the web UI on 0.0.0.0 (live server)
WEB_TOKEN=
WEB_HOST=127.0.0.1
WEB_PORT=8765
